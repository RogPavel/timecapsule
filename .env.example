# Copy to .env and adjust:  cp .env.example .env
# Real environment variables (for example from docker-compose) always win over this file.

# PostgreSQL connection.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=minibox
DB_USER=minibox
DB_PASSWORD=secret

# Where uploaded files are saved. A relative path starts at the project folder.
UPLOAD_DIR=storage/uploads

# Largest file you can upload, in megabytes.
# PHP has its own limits too (upload_max_filesize, post_max_size), see README.md.
MAX_UPLOAD_MB=10

# true = show error details on the error page (never on a public server).
APP_DEBUG=false
